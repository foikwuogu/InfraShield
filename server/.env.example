# Copy this file to .env and fill in real values

# PostgreSQL connection (local docker-compose defaults shown)
DATABASE_URL=postgresql://infrashield:infrashield@localhost:5434/infrashield

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h
OTP_PEPPER=replace_with_a_separate_random_secret
TOTP_ENCRYPTION_KEY=replace_with_a_separate_random_secret

# Required in production for generated-password and email-code delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Required only when users are allowed to self-register admin roles
ADMIN_SIGNUP_INVITE_CODE=

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Optional Twilio SMS delivery (SMS sends only to parents who explicitly opt in)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
BUS_AVERAGE_SPEED_KPH=25
